@page "/immagine"
@*  @layout CompactLayout*@
@using Microsoft.Extensions.Localization
@using TakeOffVideo.Library.Global
@using TakeOffVideo.Library.TOVFileManagerNS
@using TakeOffVideo.Localization

@inject GlobalObjects go
@inject IStringLocalizer<LangResources> Loc
@inject TOVFileManager filemanager


<nav class="navbar navbar-expand-lg navbar-light bg-light" role="navigation" aria-label="main navigation">

    <div id="navbarBasicExample" class="collapse navbar-collapse">
        <div class="navbar-nav">


            <div class="nav-item">  
                @Loc["Turno"]
            </div>
            <div class="nav-item fs-1">
                @_turno
            </div>
            <div class="nav-item">
                @Loc["Pettorale"]
            </div>
            <div class="nav-item fs-1">
                @_pettorale
            </div>
            <div class="nav-item">
                @Loc["Ora"]
            </div>
            <div class="nav-item fs-5">
                @_oraregistrazione
            </div>

        </div>

        <div class="navbar-nav ms-auto">
            <div class="nav-item">

                <div class="btn-group">

                    <div class="mb-3">
                        <input id="switchRoundedDefault" type="checkbox" name="switchRoundedDefault" 
                        class="form-check-input"
                        @bind="_autoCarica" 
                        @bind:after="() => { if(_timer!=null) _timer.Enabled = _autoCarica; } "
                        >
                        <label class="form-check-label" for="switchRoundedDefault">@Loc["Auto Carica"]</label>
                    </div>

                    @if(!_autoCarica) 
                    {       
                        <a class="btn btn-primary "  >
                            <svg fill="#000000" viewBox="0 0 24 24" id="refresh-round" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path id="secondary" d="M14.71,17.29l-2-2a1,1,0,0,0-1.42,1.42l.3.29H9A5,5,0,0,1,6.11,7.93,1,1,0,1,0,5,6.29,7,7,0,0,0,2,12a7,7,0,0,0,7,7h2.59l-.3.29a1,1,0,0,0,0,1.42,1,1,0,0,0,1.42,0l2-2A1,1,0,0,0,14.71,17.29Z" style="fill: #2ca9bc;"></path><path id="primary" d="M20,7.06A6.89,6.89,0,0,0,15,5H12.41l.3-.29a1,1,0,1,0-1.42-1.42l-2,2a1,1,0,0,0,0,1.42l2,2a1,1,0,0,0,1.42,0,1,1,0,0,0,0-1.42L12.41,7H15a5,5,0,0,1,2.89,9.07A1,1,0,1,0,19,17.71,7,7,0,0,0,22,12,6.89,6.89,0,0,0,20,7.06Z" style="fill: #000000;"></path></g></svg>                </a>


                        <a class="btn btn-primary" @onclick="() => LoadImage(TImg.Next)">
                            <svg fill="#000000" viewBox="0 0 24 24" id="left-arrow-circle" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><circle id="primary" cx="12" cy="12" r="10" style="fill: #000000;"></circle><path id="secondary" d="M17,11H11V9.86a1,1,0,0,0-1.5-.69L6.38,11.31a.82.82,0,0,0,0,1.38L9.5,14.83a1,1,0,0,0,1.5-.69V13h6a1,1,0,0,0,0-2Z" style="fill: #2ca9bc;"></path></g></svg>
                        </a>
                        <a class="btn btn-primary" @onclick="() => LoadImage(TImg.Previous)">
                            <svg fill="#000000" viewBox="0 0 24 24" id="right-arrow-circle" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><circle id="primary" cx="12" cy="12" r="10" style="fill: #000000;"></circle><path id="secondary" d="M17.62,11.31,14.5,9.17a1,1,0,0,0-1.5.69V11H7a1,1,0,0,0,0,2h6v1.14a1,1,0,0,0,1.5.69l3.12-2.14A.82.82,0,0,0,17.62,11.31Z" style="fill: #2ca9bc;"></path></g></svg>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</nav>

@if (_imageSource is not null)
{
    <p>
        <img src="@_imageSource" />
    </p>
}


@code {
    int _turno;
    string? _pettorale;
    string? _oraregistrazione;
    bool _autoCarica = true;

    System.Timers.Timer? _timer;
    protected override void OnInitialized()
    {
        _timer = new System.Timers.Timer(TimeSpan.FromSeconds(1))
            {
                AutoReset = true,
                Enabled = true
            };
        _timer.Elapsed += async (source, e) =>
        {
            await LoadImage(0);
        };
    }

    string? _currentimage;

    private string? _imageSource;



    enum TImg { Last, Previous, Next }
    
    // position = 0 : ultima
    // position = 1 -1 : successiva precedente
    private async Task LoadImage(TImg position)
    {
        var elenco = (await filemanager.GetElencoImg()).Where(f => f.StartsWith("TOV") && Path.GetExtension(f) == ".jpg")
                            .OrderByDescending(f => f).ToArray();

        if(elenco.Any())
        {
            string? nome = null;
            if(position == TImg.Last || string.IsNullOrEmpty(_currentimage))
                nome = elenco.FirstOrDefault();
            else
            {
                for(var i=0; i<elenco.Count(); ++i)
                {
                    if(elenco[i] == _currentimage)
                    {
                        if(position == TImg.Next )
                            nome = elenco[i < elenco.Length-1 ? i+1  : elenco.Length-1 ];
                        else 
                            nome = elenco[i>0 ? i-1 : 0];
                        break;
                    }
                }
            }
            


            if (nome != null && nome != _currentimage )
            {
                var video = filemanager.GetVideoDaNome(nome);

                if (video != null)
                {
                    _turno = video.Turno;
                    _pettorale = video.Pettorale;

                    _oraregistrazione =  video.OraRegistrazioneString;

                    _currentimage = nome;
                    _imageSource = await filemanager.GetUrlImage(nome);
                    StateHasChanged();
                }
            }
        }
    }

    private void OnAutoCarica()
    {
        _timer.Enabled = _autoCarica;
        
    }

}
