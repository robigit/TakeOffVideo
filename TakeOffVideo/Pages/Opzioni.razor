@page "/opzioni"
@using System.Text;
@using Microsoft.Extensions.Localization;
@using TakeOffVideo.Library.CameraSelector
@using TakeOffVideo.Library.DBFReader;
@using TakeOffVideo.Library.Global;
@using TakeOffVideo.Library.TOVFileManagerNS;
@using TakeOffVideo.Localization;
@using WebStorageManagement.Models;
@using TakeOffVideo.Library.Util;

@inject IWebStorageService webstorage

@inject GlobalObjects go
@inject IStringLocalizer<LangResources> Loc
@inject TOVFileManager filemanager
@inject FidalScraperService _fidalScraper

<h3 class="h3 mb-4">Opzioni</h3>




<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            Importazione iscritti da WISE
        </h5>
    </div>
    <div class="card-body">
        Caricare il file degli iscritti, tipo .dbf
    </div>


    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">

                <InputFile class="form-control" OnChange="@OnInputFileChange" accept=".dbf" />

                @*<input class="file-input" type="file" name="resume">*@

            </label>
            <div class="form-text">
                Seleziona file Wise…
            </div>
            <div>
                @go.NomeFileDbf
            </div>
        </div>

        
    </div>
    

    @if (go.Atleti != null)
    {
        <div class="card-body">
            <div class="mb-3">
                    <select class="form-select" @onchange="SelezionaGara" >
                        <option>Seleziona la gara</option>
                    @foreach(var gara in go.Atleti.Select(a => $"{a.CODGARA} - {a.INTESTAZIO}").Distinct())
                    {
                        <option  >@gara</option>
                    
                    }
                </select>
            </div>
            @if (go.Atleti != null)
            {
                <div class="mb-3">
                    <select class="form-select">
                        @foreach (var atl in go.Atleti.Where(a => a.CODGARA == go.GaraSel && a.CONFERMA == "S")
                       .OrderBy(a => a.PettNum))
                        {
                            <option>@atl</option>

                        }
                    </select>
                </div>
            }

            <button class="btn btn-primary" @onclick="PulisciAtleti"  >Pulisci</button>

        </div>
    }

</div>

<br />

<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="card-title mb-0">
            Importazione iscritti da FIDAL
        </h5>
    </div>
    <div class="card-body">
        <p>Copia le righe della tabella dal sito FIDAL e incollale qui sotto per importare automaticamente gli atleti.</p>

        <div class="mb-3">
            <textarea class="form-control" rows="5" placeholder="Incolla qui il testo copiato dalla tabella del sito FIDAL..." @bind="_pastedText"></textarea>
            <button class="btn btn-info text-white mt-2" type="button" @onclick="ImportaDaTesto" disabled="@_isImporting">
                @if (_isImporting) { <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> }
                else { <span>Importa Da Testo</span> }
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_fidalMessage))
        {
            <div class="alert @(_fidalMessage.Contains("Errore") || _fidalMessage.Contains("Nessun") ? "alert-warning" : "alert-success") mt-3" role="alert">
                @_fidalMessage
            </div>
        }
    </div>
</div>

<br />

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">
            <i class="bi bi-robot me-2"></i>Integrazione Google Gemini AI
        </h5>
    </div>
    <div class="card-body">
        <p>Inserisci la chiave API per attivare il rilevamento automatico avanzato del nullo tramite intelligenza artificiale visiva (Gemini Vision).</p>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Gemini API Key</label>
            <div class="input-group">
                <input type="@(_showGeminiKey ? "text" : "password")" class="form-control" placeholder="es. AIzaSy..." @bind="_geminiApiKey" autocomplete="off">
                <button class="btn btn-outline-secondary" type="button" @onclick="() => _showGeminiKey = !_showGeminiKey">
                    <i class="bi @(_showGeminiKey ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
            <div class="form-text mt-2">
                Non hai una chiave? <a href="https://aistudio.google.com/" target="_blank" class="text-primary text-decoration-none"><i class="bi bi-box-arrow-up-right me-1"></i>Generala gratis su Google AI Studio</a>.
            </div>
        </div>

        <button class="btn btn-primary" @onclick="SalvaGeminiKey">
            <i class="bi bi-save me-1"></i>Salva Chiave
        </button>

        @if (!string.IsNullOrEmpty(_geminiMessage))
        {
            <div class="mt-3 text-success">
                <i class="bi bi-check-circle-fill me-1"></i>@_geminiMessage
            </div>
        }
    </div>
</div>

<br />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            Selezione camera di Default
        </h5>
    </div>
    <div class="card-body">
        Selezionare la camera che verrà caricata automaticamente all'avvio
    </div>


    <div class="card-body">
        
        <div class="row">
            
            <div class="col-md-6">
        <CameraSelector OnCameraSelected="OnCameraSelected"  />
            </div>
            
        </div>
        
    </div>
</div>


<br />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            Tipo Registrazione
        </h5>

    </div>
    <div class="card-body">
        <div class="content">
            Nella modalita' a registrazione singola bisogna premere il bottone sia per far partire che per salvare il file.
            <br />
            Nella modalita' a registrazione continua invece il programma è sempre in registrazione e si preme il bottone per salvare
            (in questa modalità i video sono molto più lunghi). Sperimentale.
        </div>



        <div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="registrazione" id="reg1" checked="@(!RegistrazioneContinua)"
                @onchange="Cambia">
                <label class="form-check-label" for="reg1">
                    Registrazione singola
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="registrazione" id="reg2" checked="@(RegistrazioneContinua)"
                @onchange="Cambia">
                <label class="form-check-label" for="reg2">
                    Registrazione continua
                </label>
            </div>
        </div>
    </div>
</div>




@code {
    bool RegistrazioneContinua;

    // FIDAL Variables
    private string _pastedText = "";
    private string _fidalMessage = "";
    private bool _isImporting = false;

    // Gemini Variables
    private string _geminiApiKey = "";
    private bool _showGeminiKey = false;
    private string _geminiMessage = "";

    private async Task SalvaGeminiKey()
    {
        if (string.IsNullOrWhiteSpace(_geminiApiKey))
        {
            await webstorage.LocalStorage.Save("GeminiApiKey", "");
            _geminiMessage = "Chiave API rimossa.";
        }
        else
        {
            await webstorage.LocalStorage.Save("GeminiApiKey", _geminiApiKey.Trim());
            _geminiMessage = "Chiave API salvata con successo!";
        }
        
        // Nascondi messaggio dopo 3 secondi
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            _geminiMessage = "";
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task SalvaAtletiEstratti(List<Atleta> estratti)
    {
        if (estratti.Count == 0)
        {
            _fidalMessage = "Nessun atleta trovato.";
            return;
        }

        // Recuperiamo quelli attuali, se presenti
        var strCache = await webstorage.LocalStorage.Read("AtletiLocali");
        if (!string.IsNullOrEmpty(strCache))
        {
            var tempList = System.Text.Json.JsonSerializer.Deserialize<List<Atleta>>(strCache);
            if (tempList != null) go.AtletiLocali = tempList;
        }

        int aggiunti = 0;
        foreach (var a in estratti)
        {
            if (!go.AtletiLocali.Any(al => al.Pettorale == a.Pettorale && al.Nome == a.Nome && al.Cognome == a.Cognome))
            {
                go.AtletiLocali.Add(a);
                aggiunti++;
            }
        }

        if (aggiunti > 0)
        {
            await webstorage.LocalStorage.Save("AtletiLocali", System.Text.Json.JsonSerializer.Serialize(go.AtletiLocali));
            _fidalMessage = $"Importazione completata: {aggiunti} atleti estratti inseriti negli Atleti Locali!";
        }
        else
        {
            _fidalMessage = "Nessun nuovo atleta da aggiungere (tutti già presenti negli Atleti Locali).";
        }
        StateHasChanged();
    }

    private async Task OnFidalFileChange(InputFileChangeEventArgs e)
    {
        _isImporting = true;
        _fidalMessage = "Elaborazione file in corso...";
        StateHasChanged();

        try
        {
            using var stream = e.File.OpenReadStream(10_000_000); // 10MB max
            var estratti = await _fidalScraper.GetAtletiFromStreamAsync(stream);
            await SalvaAtletiEstratti(estratti);
        }
        catch (Exception ex)
        {
            _fidalMessage = $"Errore elaborazione: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }

    private async Task ImportaDaTesto()
    {
        if (string.IsNullOrWhiteSpace(_pastedText)) return;
        _isImporting = true;
        _fidalMessage = "Elaborazione testo in corso...";
        StateHasChanged();

        try
        {
            var estratti = await _fidalScraper.GetAtletiFromTextAsync(_pastedText);
            await SalvaAtletiEstratti(estratti);
        }
        catch (Exception ex)
        {
            _fidalMessage = $"Errore elaborazione: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }

    private async Task Cambia()
    {
        RegistrazioneContinua = !RegistrazioneContinua;
        await webstorage.LocalStorage.Save("TipoRec", RegistrazioneContinua.ToString());

    }


    protected override async Task OnInitializedAsync()
    {
        RegistrazioneContinua = await webstorage.LocalStorage.Read("TipoRec") == "True";

        var savedKey = await webstorage.LocalStorage.Read("GeminiApiKey");
        if (!string.IsNullOrEmpty(savedKey))
        {
            _geminiApiKey = savedKey;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var ID = await webstorage.LocalStorage.Read("IDCameraDefault");

        }
    }


    private void SelezionaGara(ChangeEventArgs e)
    {
        if (e?.Value != null)
        {
            var pz = e.Value.ToString().Split('-', StringSplitOptions.TrimEntries);
            go.GaraSel = pz[0];
        }
    }

    private void PulisciAtleti()
    {
        go.Atleti = null;
        go.GaraSel = null;
        go.NomeFileDbf = null;
        StateHasChanged();
    }

    private async void OnInputFileChange(InputFileChangeEventArgs e)
    {
        go.NomeFileDbf = e.File.Name;
        using (var memstream = new MemoryStream())
        {
            await e.File.OpenReadStream().CopyToAsync(memstream);

            //go.Atleti = (await DBFReader.GetFieldNames(memstream)).Select(n=> new AtletaWise { PETTO = "0", CODGARA = n, NOMINATIVO = n });

            go.Atleti = await DBFReader.ReadToObject<AtletaWise>(memstream);
            StateHasChanged();

        }


    }

    private async void OnCameraSelected(string camera)
    {
        await webstorage.LocalStorage.Save("IDCameraDefault", camera);
        //_cameraselected = camera;
        //if (_cameraselected != null)
        //    _videoMarker?.StartVideo(_cameraselected);
    }

    

}
