@page "/"
@page "/{Modalita}"
@using WebStorageManagement.Models;

@inject IJSRuntime jsRuntime
@inject IWebStorageService webStorage

<PageTitle>Take Off Video</PageTitle>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card fade-in">
            <div class="card-body">
                <TakeOffVideo.Recorder.Recorder />
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card fade-in">
            <div class="card-body">
                <TakeOffVideo.Analyzer.Analyzer/>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public string? Modalita { get; set; }

    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("loadburger");

        }

    }

}