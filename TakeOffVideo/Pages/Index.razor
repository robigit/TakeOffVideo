@page "/"
@page "/{Modalita}"
@using WebStorageManagement.Models;
@using TakeOffVideo.Library.ModalDialog

@inject IJSRuntime jsRuntime
@inject IWebStorageService webStorage

<PageTitle>Take Off Video</PageTitle>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card fade-in">
            <div class="card-body">
                <TakeOffVideo.Recorder.Recorder />
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card fade-in">
            <div class="card-body">
                <TakeOffVideo.Analyzer.Analyzer @ref="_analyzer" OnZoomRequested="OpenZoom"/>
            </div>
        </div>
    </div>
</div>

@if(_showZoom && !string.IsNullOrEmpty(_zoomVideoUrl))
{
    <ModalZoom Url="@_zoomVideoUrl" OnClose="CloseZoom" />
}

@code {

    TakeOffVideo.Analyzer.Analyzer? _analyzer;
    bool _showZoom = false;
    string? _zoomVideoUrl;

    [Parameter]
    public string? Modalita { get; set; }

    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("loadburger");

        }

    }

    private void OpenZoom(string videoUrl)
    {
        _zoomVideoUrl = videoUrl;
        _showZoom = true;
        StateHasChanged();
    }

    private void CloseZoom(bool close)
    {
        _showZoom = false;
        StateHasChanged();
    }

}