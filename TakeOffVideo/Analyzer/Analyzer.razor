@using Microsoft.Extensions.Localization;
@using TakeOffVideo.Library.TOVFileManagerNS;
@using TakeOffVideo.Library.VideoMarker
@using TakeOffVideo.Library.VideoUploader
@using TakeOffVideo.Library.VideoFileManager

@using Localization

@inject IStringLocalizer<LangResources> Loc

@inject TOVFileManager videofilemanager
@inject TakeOffVideo.Library.Util.GeminiVisionService _geminiService
@inject WebStorageManagement.Models.IWebStorageService _webstorage

@implements IDisposable

<h2 class="mb-4">
    <i class="bi bi-play-circle me-2"></i>@Loc["Analisi"]
</h2>

<VideoMarker OnImageRecorded="SalvaImmagine" 
             OnZoomRequested="HandleZoomRequest"
             OnNulloChecked="OnNulloResult"
             OnNulloAiRequested="OnNulloAiRequested"
             ConImageRec="ConImageRec" 
             ConNulloCheck="true"
             Ruolo="VideoMarker.TVideo.Analyzer"
             WidthVideo="640" 
             HeigthVideo="640" 
             ConControls=true 
             @ref="_videoMarker" />

@if (_nulloResult != null)
{
    <div class="row justify-content-center mt-2">
        <div class="col-auto">
            <div class="alert alert-info d-flex align-items-center gap-2 py-1 px-3 mb-2" role="alert" style="font-size: 0.82rem; border-radius: 8px;">
                <i class="bi bi-flask me-1"></i>
                <span><strong>Funzionalità BETA</strong> — Il rilevamento automatico del nullo è sperimentale e verrà migliorato nelle versioni future. I risultati potrebbero non essere precisi al 100%.</span>
            </div>
            <div class="alert @(_nulloResult.IsNullo ? "alert-danger" : "alert-success") d-flex align-items-center gap-3 py-2 px-4 shadow" role="alert" style="font-size: 1.1rem; border-radius: 12px;">
                @if (_isAnalyzingAi)
                {
                    <div class="spinner-border text-primary fs-3" role="status"></div>
                }
                else
                {
                    <i class="bi @(_nulloResult.IsNullo ? "bi-x-circle-fill" : "bi-check-circle-fill") fs-3"></i>
                }
                <div>
                    <strong>@(_nulloResult.IsNullo ? "⛔ NULLO" : "✅ VALIDO")</strong>
                    <span class="badge bg-warning text-dark ms-2" style="font-size: 0.65rem; vertical-align: middle;">BETA</span>
                    <small class="d-block text-muted">@_nulloResult.Messaggio &nbsp;|&nbsp; Modalità: @_nulloResult.Modalita</small>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3 mt-3">
    <div class="col-lg-8">
        <VideoFileManagerTable OnPlayVideo="OnVideoSelected" />
    </div>
    <div class="col-lg-4">
        <VideoUploader Testo=@Loc["Carica…"] OnVideoUploaded="OnVideoUploaded" />
    </div>
</div>





@code {
    VideoMarker? _videoMarker;

    bool ConImageRec = false;
    VideoMarker.NulloResult? _nulloResult = null;
    bool _isAnalyzingAi = false;

    void OnNulloResult(VideoMarker.NulloResult r)
    {
        _nulloResult = r;
        StateHasChanged();
    }

    async Task OnNulloAiRequested(string base64Frame)
    {
        var apiKey = await _webstorage.LocalStorage.Read("GeminiApiKey");
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            _nulloResult = new VideoMarker.NulloResult(false, 0, "Inserisci la chiave API Gemini nelle Opzioni per usare l'AI", "Gemini AI");
            StateHasChanged();
            return;
        }

        _isAnalyzingAi = true;
        _nulloResult = new VideoMarker.NulloResult(false, 0, "L'intelligenza artificiale sta analizzando il salto... attendere.", "Gemini AI");
        StateHasChanged();

        try
        {
            var result = await _geminiService.AnalyzeFoulAsync(base64Frame, apiKey);
            _nulloResult = new VideoMarker.NulloResult(result.IsNullo, 99, result.Messaggio, "Gemini AI");
        }
        catch (Exception ex)
        {
            _nulloResult = new VideoMarker.NulloResult(false, 0, $"Errore API Gemini: {ex.Message}", "Gemini AI");
        }
        finally
        {
            _isAnalyzingAi = false;
            StateHasChanged();
        }
    }

    [Parameter]
    public EventCallback<string> OnZoomRequested { get; set; }

    protected override void OnInitialized()
    {
        ConImageRec = videofilemanager.GetNomeDir() != null;
    }


    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            videofilemanager.OnNuovo += OnNuovo;
        }
    }

    public void Dispose()
    {
        videofilemanager.OnNuovo -= OnNuovo;
    }

    //string? _urlattuale;

    VideoFile? _videoattuale = null;


    private async Task OnVideoSelected(VideoFile video)
    {
        _videoattuale = video;
        if (_videoattuale != null)
        {

            Console.WriteLine($"OnVideoSelected {_videoattuale.Url}");
            if(_videoMarker!=null)
                await _videoMarker.SetVideo(_videoattuale.Url);
        }

    }



    private async Task OnNuovo(VideoFile video)
    {
        _videoattuale = video;

        Console.WriteLine($"Caricato un video nuovo {_videoattuale.Url}");

        await _videoMarker.SetVideo(_videoattuale.Url, video.Durata);
        //StateHasChanged();
        //await Task.CompletedTask;
    }

    private async Task OnVideoUploaded(OnVideoUploadesArgs e)
    {
        var ret = await videofilemanager.AggiungiDaFile(e.Url, e.Nomefile);
    }

    private async Task SalvaImmagine(string url)
    {
        string nome = "Image.jpg";
        if(_videoattuale!=null)
            nome = _videoattuale.SoloNome + ".jpg";

        await videofilemanager.SalvaFileSuCartellaImg(nome, url);
    }

    private async Task HandleZoomRequest()
    {
        if (_videoattuale != null && OnZoomRequested.HasDelegate)
        {
            await OnZoomRequested.InvokeAsync(_videoattuale.Url);
        }
    }
    
}
