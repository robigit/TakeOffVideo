@using TakeOffVideo.Library.TOVFileManagerNS;
@using TakeOffVideo.Library.ModalDialog

@inject IStringLocalizer<LangResources> Loc
@inject TOVFileManager filemanager

<div class="mb-3">
    <label class="form-label small">@Loc["DownloadFolder"]</label>
    <div class="input-group input-group-sm">
        <input class="form-control" readonly value="@NomeCartella">
        <button class="btn btn-primary" @onclick="GetDir">
            <img src="image/folder24.png" alt="folder" height="16">
        </button>
    </div>
</div>

@if(!string.IsNullOrWhiteSpace(TestoDialog))
{
<ModalDialog Text="@TestoDialog" Title=@Loc["Attenzione"] OnClose="ChiudiDialog"  />
}



@code {
    private string? TestoDialog;
    private void MostraDialog(string testo)
    {
        TestoDialog = testo;
        StateHasChanged();
    }

    private void ChiudiDialog(bool _)
    {
        TestoDialog = null;
    }
    
    string? NomeCartella = "<Download>";
    private async Task GetDir()
    {
        try
        {
            var tipo = await filemanager.ShowDirectoryPicker();

            if (tipo == TOVFileManager.TipoScelta.Ok)
                NomeCartella = filemanager.GetNomeDir();
            else
            {
                if (tipo == TOVFileManager.TipoScelta.NotSupported)
                    MostraDialog(Loc["FolderNotSupported"]);
            }

            StateHasChanged();

        }
        catch (Exception e)
        {
            MostraDialog($"{e} {e.Message}");
        }
    }
}