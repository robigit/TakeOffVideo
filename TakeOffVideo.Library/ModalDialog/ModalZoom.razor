
@inject IStringLocalizer<LangResources> Loc

@inject WebStorageManagement.Models.IWebStorageService webstorage


<div class="modal fade @(active ? "show d-block" : "")" tabindex="-1" style="@(active ? "position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0,0,0,0.8); z-index: 9999;" : "")">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">@Loc["Zoom"]</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Chiudi" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex justify-content-center align-items-center">
                <TakeOffVideo.Library.VideoMarker.VideoMarker @ref="_video"
                    ConControls="true" 
                    ConZoom="false"
                    FullScreen="true" 
                    Ruolo="VideoMarker.VideoMarker.TVideo.Zoom"
                    Url="@Url" />
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-warning" @onclick="Chiudi">@Loc["Chiudi"]</button>
            </div>
        </div>
    </div>
</div>


@code {

    private TakeOffVideo.Library.VideoMarker.VideoMarker? _video;

    bool active = true;


    protected override async Task OnInitializedAsync()
    {
        var l = await webstorage.SessionStorage.Read("ZoomLinePos");

        Console.WriteLine($"ModalZoom In {l}");

        if (int.TryParse(l, out int pos))
            LinePosition = pos;

    }


    [Parameter]
    public string? Url { get; set; }


    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    public int LinePosition { get; set; } = 0;

    protected async Task Chiudi()
    {
        active = false;
        StateHasChanged();
        await Task.Delay(300); // Allow fade animation to complete
       
        await OnClose.InvokeAsync(true);
    }

   
}
