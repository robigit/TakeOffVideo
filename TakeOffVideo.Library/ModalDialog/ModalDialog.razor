
@inject IStringLocalizer<LangResources> Loc

<div class="modal fade @showClass" style="display: @displayStyle;" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">@Title</h5>
        <button type="button" class="btn-close" @onclick="Chiudi" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        @Text
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-warning" @onclick="Chiudi">@Loc["Chiudi"]</button>
      </div>
    </div>
  </div>
</div>
@if (showBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}


@code {
    string showClass = "show";
    string displayStyle = "block";
    bool showBackdrop = true;

    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    protected void Chiudi()
    {
        showClass = "";
        displayStyle = "none";
        showBackdrop = false;
        OnClose.InvokeAsync(true);
    }
}
