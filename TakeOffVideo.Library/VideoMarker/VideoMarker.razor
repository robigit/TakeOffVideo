@using Microsoft.JSInterop
@using TakeOffVideo.Library.ModalDialog
@using TakeOffVideo.Library.TOVFileManagerNS;

@inject IJSRuntime JS

@inject TOVFileManager filemanager

@implements IAsyncDisposable
@implements IDisposable

@inject IStringLocalizer<LangResources> Loc
@inject WebStorageManagement.Models.IWebStorageService webstorage



<div class="container">
    
    <!-- Video Preview Section -->
    <div class="row justify-content-center mb-3">
        <div class="col-auto">
            <div class="vmcontainer position-relative" @ref="_container" @onclick="OnContainerClick">
                <div class="vmvideo border rounded shadow-sm" style="background: #000;">
                    <video width="@WidthVideo" height="@HeigthVideo" @ref="_video" preload="auto" playsInline />
                </div>
                @if (_lineavisibile)
                {
                    <div class="vmlinea" @ref="_linea"></div>
                }
                @if (_foulZoneVisible)
                {
                    <div class="vm-foul-zone" style="right: calc(50% + @(-_lineaPosition)px); left: 0;"></div>
                }
                @if (_refPointX.HasValue)
                {
                    <div class="vm-ref-point" style="left: @(_refPointX)px; top: 50%;"></div>
                }
            </div>
        </div>
    </div>

    <!-- Combined Line and Frame Controls Section -->
    <div class="row justify-content-center mb-3">
        <div class="col-auto">
            <div class="d-flex gap-2 flex-nowrap justify-content-center align-items-center">
                <!-- Line Controls -->
                <div class="btn-group" role="group" aria-label="@Loc["ControlliLinea"]">
                    <button class="btn btn-sm btn-outline-secondary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => MostraLinea())" title="@_textlinea">
                        <i class="bi @(_lineavisibile ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                    @if (_lineavisibile)
                    {
                        <button class="btn btn-sm btn-outline-secondary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => Move("sx", 10))" title="@Loc["SpostaSinistra"] 10px">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => Move("sx", 1))" title="@Loc["SpostaSinistra"] 1px">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => Move("dx", 1))" title="@Loc["SpostaDestra"] 1px">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => Move("dx", 10))" title="@Loc["SpostaDestra"] 10px">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    }
                </div>

                @if (!ConRecorder)
                {
                    <!-- Frame Controls (Analyzer Mode) -->
                    <div class="btn-group" role="group" aria-label="@Loc["ControlliFrame"]">
                        <button class="btn btn-sm btn-outline-primary" style="padding: 0.25rem 0.5rem;" disabled>
                            <i class="bi bi-sliders"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => AdvanceFrame(-10))" title="@Loc["IndietroFrame"] 10">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => AdvanceFrame(-2))" title="@Loc["IndietroFrame"] 2">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => AdvanceFrame(2))" title="@Loc["AvantiFrame"] 2">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" style="padding: 0.25rem 0.5rem;" @onclick="@(() => AdvanceFrame(10))" title="@Loc["AvantiFrame"] 10">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    </div>
                    
                    @if (ConZoom)
                    {
                        <button class="btn btn-sm btn-outline-info" style="padding: 0.25rem 0.5rem;" @onclick="ZoomClick" title="@Loc["Zoom"]">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                    }
                    
                    @if (ConImageRec)
                    {
                        <button class="btn btn-sm @(savingimage ? "btn-outline-secondary" : "btn-outline-danger")" 
                                style="padding: 0.25rem 0.5rem;"
                                @onclick="GetImageClick" 
                                disabled="@savingimage" 
                                title="@Loc["SalvaImmagine"]">
                            <i class="bi bi-camera-fill me-1"></i>
                            @if (savingimage)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            
                        </button>
                    }

                    @if (ConNulloCheck)
                    {
                        <div class="btn-group" role="group" aria-label="Controllo Nullo">
                            <button class="btn btn-sm btn-outline-warning" style="padding: 0.25rem 0.5rem;"
                                    @onclick="CheckNulloAuto" title="Analisi pixel automatica (zona sinistra barra)">
                                <i class="bi bi-search me-1"></i>Nullo Auto
                            </button>
                            <button class="btn btn-sm @(_waitingRefPoint ? "btn-warning" : "btn-outline-warning")" style="padding: 0.25rem 0.5rem;"
                                    @onclick="ToggleRefPointMode" title="Clicca sul piede nel video per impostare il punto di riferimento">
                                <i class="bi bi-crosshair me-1"></i>@(_waitingRefPoint ? "Clicca sul piede..." : "Nullo (Punto)")
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (ConRecorder)
    {
        <!-- Recording Controls Section -->
        <div class="row justify-content-center mb-3">
            <div class="col-12">
                <div class="row g-3">
                    <div class="col-8">
                        <button @ref="_startstopbutton"
                                class="btn btn-lg w-100 shadow-sm @(_inregistrazione ? "btn-danger" : "btn-success")"
                                @onclick="OnRegistra">
                            <i class="bi @(_inregistrazione ? "bi-stop-circle-fill" : "bi-record-circle-fill") me-2"></i>
                            <strong>@(_inregistrazione ? Loc["Salva"] : Loc["Registra"])</strong>
                            @if (RegistrazioneContinua)
                            {
                                <small class="d-block mt-1" style="font-size: 0.75rem;">(@Loc["ModoContinua"])</small>
                            }
                        </button>
                    </div>
                    <div class="col-4">
                        <button @ref="_cancelbutton" 
                                class="btn btn-lg btn-warning w-100 shadow-sm text-nowrap" 
                                disabled="@(!_inregistrazione)">
                            <i class="bi bi-x-circle-fill me-1"></i>
                            @Loc["Annulla"]
                        </button>
                    </div>
                </div>

                <!-- Progress Bar -->
                @if(_inregistrazione)
                {
                    <div class="mt-3">
                        <div class="progress shadow-sm" style="height: 30px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" 
                                 role="progressbar" 
                                 style="width: @(_progressoregistrazione)%"
                                 aria-valuenow="@_progressoregistrazione" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                <strong><i class="bi bi-record-fill me-2"></i>@Loc["Registrazione"]... @(_progressoregistrazione)%</strong>
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>
                                @if (RegistrazioneContinua)
                                {
                                    <text>@Loc["ModoContinua"]</text>
                                }
                                else
                                {
                                    <text>@Loc["AutoStop"] 10s</text>
                                }
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Alert/Notification Section -->
    @if (!string.IsNullOrEmpty(_notificamsg))
    {
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @_notificamsg
                    <button type="button" class="btn-close" @onclick="DelNotification" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

</div>



@code {

    private bool _lineavisibile = true;

    private string _textlinea => _lineavisibile ? Loc["Nascondi Linea"] : Loc["Mostra Linea"];

    private string _controls = "false";

    private IJSObjectReference? _JScript;
    private DotNetObjectReference<VideoMarker>? _reference;

    private ElementReference _video;
    private ElementReference _container;
    private ElementReference _linea;

    private ElementReference _startstopbutton;
    private ElementReference _cancelbutton;

    public enum TVideo { Analyzer, Recorder, Zoom }


    [Parameter] public string? Url { get; set; }
    [Parameter] public int WidthVideo { get; set; } = 320;
    [Parameter] public int HeigthVideo { get; set; } = 320;
    [Parameter] public bool ConRecorder { get; set; } = false;
    [Parameter] public bool ConControls { get; set; } = false;

    [Parameter] public bool ConImageRec { get; set; } = false;
    [Parameter] public bool ConNulloCheck { get; set; } = false;

    [Parameter] public EventCallback<string> OnImageRecorded { get; set; }
    [Parameter] public EventCallback<NulloResult> OnNulloChecked { get; set; }

    [Parameter] public EventCallback<OnVideoRecordedArgs> OnVideoRecorded { get; set; }

    [Parameter] public EventCallback OnZoomRequested { get; set; }

    [Parameter] public bool RegistrazioneContinua { get; set; } = false;

    [Parameter] public bool FullScreen { get; set; } = false;

    [Parameter] public bool ConZoom { get; set; } = true;

    [Parameter] public TVideo Ruolo { get; set; } = 0;

    public record NulloResult(bool IsNullo, int Confidenza, string Messaggio, string Modalita);




    private bool _inregistrazione = false;
    private int _progressoregistrazione = 0;



    bool savingimage = false;


    System.Timers.Timer? _timer;
    System.Timers.Timer? _progressTimer;
    
    protected override void OnInitialized()
    {
        base.OnInitialized();


        if (ConRecorder)
        {
            // Progress bar update timer (for both modes)
            _progressTimer = new System.Timers.Timer(100)
                {
                    AutoReset = true,
                    Enabled = false
                };
            _progressTimer.Elapsed += async (source, e) =>
            {
                if (_inregistrazione)
                {
                    var elapsed = (DateTime.Now - _startTime).TotalSeconds;
                    if (!RegistrazioneContinua)
                    {
                        // Auto-stop mode: progress from 0% to 100% in 10 seconds
                        _progressoregistrazione = (int)Math.Min(elapsed * 10, 100);
                    }
                    else
                    {
                        // Continuous mode: show elapsed time as indeterminate progress (pulse between 10-100%)
                        _progressoregistrazione = (int)(50 + 40 * Math.Sin(elapsed * 2));
                    }
                    await InvokeAsync(StateHasChanged);
                }
            };
            
            if (!RegistrazioneContinua)
            {
                _timer = new System.Timers.Timer(10000)
                    {
                        AutoReset = false,
                        Enabled = false
                    };
                _timer.Elapsed += async (source, e) =>
                {
                    _timer.Enabled = false;
                    if (_inregistrazione && _JScript != null)
                    {
                        await _JScript.InvokeVoidAsync("pressbutton", _startstopbutton);
                    }
                };
            }
        }

    }

    public class WindowDimension
    {
        public int Width { get; set; }
        public int Height { get; set; }

    }

    private string IDSession => $"{nameof(VideoMarker)}-{Ruolo}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            _JScript = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/TakeOffVideo.Library/VideoMarker/VideoMarker.razor.js");
            _reference = DotNetObjectReference.Create(this);


            //await _JScript.InvokeVoidAsync("SettaControlsVideo", _video, ConControls);

            await _JScript.InvokeVoidAsync("SettaAttributeVideo", _video, "controls", ConControls);

            await _JScript.InvokeVoidAsync("SettaAttributeVideo", _video, "autoplay", ConRecorder);


            await _JScript.InvokeVoidAsync("InitKeyboard", _startstopbutton);


            if(FullScreen)
            {
                //await _JScript.InvokeVoidAsync("setfullscreen", _reference);

                var size = await _JScript.InvokeAsync<WindowDimension>("getvideosize");
                var dim = Math.Min(size.Height, size.Width)+150;
                HeigthVideo = dim;
                WidthVideo = dim;
                StateHasChanged();
            }


            if (Url != null && _JScript != null)
            {
                await _JScript.InvokeVoidAsync("caricavideo", _video, Url);
            }


            var locpos = await webstorage.SessionStorage.Read(IDSession);

            if (_JScript != null && locpos!=null && int.TryParse(locpos, out int lp))
            {
                await _JScript.InvokeVoidAsync("setlineposition", _linea, lp);
            }

        }
    }


    protected override async Task OnParametersSetAsync()
    {
        //Console.WriteLine($"carica video4 {Url} {(_JScript != null)} ");

        //if(Url != null && _JScript!=null)
        //{
        //    Console.WriteLine($"carica video3 {Url}");

        //    await _JScript.InvokeVoidAsync("caricavideo", _video, Url);

        //    Console.WriteLine($"carica video {Url}");
        //}
    }

    public async Task SetVideo(string url, TimeSpan? position=null)
    {
        Url = url;

        if (Url != null && _JScript != null)
        {
            await _JScript.InvokeVoidAsync("caricavideo", _video, Url);

            if(position.HasValue)
            {
                await _JScript.InvokeVoidAsync("SettaCurrentTime", _video, position.Value.TotalSeconds-2);
            }

            Console.WriteLine($"carica video2 {Url}");
        }

    }

    private void MostraLinea()
    {
        _lineavisibile = !_lineavisibile;
        if (!_lineavisibile) _foulZoneVisible = false;
    }

    private async Task Move(string direction, int pixels)
    {
        if (_JScript == null)
            return;

        await _JScript.InvokeVoidAsync("move", direction, _container, _linea, pixels);

        var lp = await _JScript.InvokeAsync<int>("getlineposition", _linea);
        _lineaPosition = lp;
        await webstorage.SessionStorage.Save(IDSession, lp.ToString());
    }

    // ── Nullo detection ──────────────────────────────────────────────

    bool _foulZoneVisible = false;
    bool _waitingRefPoint = false;
    double? _refPointX = null;
    int _lineaPosition = 0;

    private async Task CheckNulloAuto()
    {
        if (_JScript == null || !_lineavisibile) return;
        _foulZoneVisible = false;
        _refPointX = null;

        var result = await _JScript.InvokeAsync<NulloResultJS>("checkNulloAuto", _video, _linea, _container);
        _foulZoneVisible = result.IsNullo;

        var nr = new NulloResult(result.IsNullo, result.Confidenza, result.Messaggio, "Auto");
        if (OnNulloChecked.HasDelegate)
            await OnNulloChecked.InvokeAsync(nr);

        StateHasChanged();
    }

    private async Task ToggleRefPointMode()
    {
        _waitingRefPoint = !_waitingRefPoint;
        _refPointX = null;
        if (_JScript != null)
            await _JScript.InvokeVoidAsync("setReferencePoint", -1, -1); // clear
        StateHasChanged();
    }

    private async Task OnContainerClick(MouseEventArgs e)
    {
        if (!_waitingRefPoint || _JScript == null) return;

        _refPointX = e.OffsetX;
        await _JScript.InvokeVoidAsync("setReferencePoint", e.OffsetX, e.OffsetY);
        _waitingRefPoint = false;

        // Immediately run the ref-point check
        var result = await _JScript.InvokeAsync<NulloResultJS>("checkNulloByRef", _linea, _container);
        _foulZoneVisible = result.IsNullo;

        var nr = new NulloResult(result.IsNullo, result.Confidenza, result.Messaggio, "Punto");
        if (OnNulloChecked.HasDelegate)
            await OnNulloChecked.InvokeAsync(nr);

        StateHasChanged();
    }

    private record NulloResultJS(bool IsNullo, int Confidenza, string Messaggio);

    private async Task AdvanceFrame(int steps)
    {
        if (_JScript == null)
            return;


        await _JScript.InvokeVoidAsync("AdvanceFrame", _video, steps);
    }

    private async Task SettaCurrentTime(double secs)
    {
        if (_JScript == null)
            return;


        await _JScript.InvokeVoidAsync("SettaCurrentTime", _video, secs);
    }

    public async Task StartVideo(string camera)
    {
        if (_JScript == null)
            return;
        _cameraselected = camera;

        Console.WriteLine($"Inizio video {camera}");

        await _JScript.InvokeVoidAsync("startVideo", _video, camera);
    }


    string? _cameraselected;

    DateTime _startTime;
    TimeSpan _durata;

    private async Task OnRegistra()
    {
        if (_timer != null)
            _timer.Enabled = false;
        if (_progressTimer != null)
            _progressTimer.Enabled = false;

        if (_JScript == null || string.IsNullOrEmpty(_cameraselected))
        {
            SettaNotifica( "Selezionare una Videocamera");
            return;
        }



        _inregistrazione = !_inregistrazione;


        if (_inregistrazione)
        {
            _startTime = DateTime.Now;
            _progressoregistrazione = 0;

            Console.WriteLine($"Inizio Registrazione");

            await _JScript.InvokeVoidAsync("StartRec", _video, _startstopbutton, _cameraselected, _reference, _cancelbutton);
            if (_timer != null)
            {
                _timer.Enabled = true;
            }
            if (_progressTimer != null)
            {
                _progressTimer.Enabled = true;
            }
        }
        else
        {
            _durata = DateTime.Now - _startTime;
            if (_progressTimer != null)
            {
                _progressTimer.Enabled = false;
            }
            _progressoregistrazione = 0;
        }

    }


    [JSInvokable]
    public async Task SalvaUrlVideo(string url, string tipo)
    {
        Console.WriteLine($"SalvaUrlVideo {url}");
        await OnVideoRecorded.InvokeAsync(new OnVideoRecordedArgs(url, tipo, _durata));

        if (RegistrazioneContinua && _JScript!=null)
            await _JScript.InvokeVoidAsync("pressbutton", _startstopbutton);
        //await filemanager.SalvaFileSuCartella("nome.webm", url);

    }

    [JSInvokable]
    public async Task CancelRec()
    {
        Console.WriteLine($"CancelRec");
        _inregistrazione = false;
        if (_progressTimer != null)
        {
            _progressTimer.Enabled = false;
        }
        _progressoregistrazione = 0;
        StateHasChanged();
    }

    async Task ZoomClick()
    {
        await OnZoomRequested.InvokeAsync();
    }

    async Task GetImageClick()
    {
        if (_JScript == null)
            return;
        savingimage = true;
        try
        {
            //await _JScript.InvokeVoidAsync("document.body.style.cursor = 'wait'");
            
            await _JScript.InvokeVoidAsync("getCurrentCanvasFrame", _video, _reference, "ProcessImage");
           
        }
        finally
        {
            savingimage = false;
        }
        //await _JScript.InvokeVoidAsync("document.body.style.cursor = 'wait'");
        SettaNotifica("Immagine salvata");
    }


    [JSInvokable]
    public async Task ProcessImage(string imageString)
    {
        if(OnImageRecorded.HasDelegate)
            await OnImageRecorded.InvokeAsync(imageString);
    }


    void DelNotification()
    {
        _notificamsg = null;
    }


    string? _notificamsg;
    System.Timers.Timer? _timernotifica = null;

    void SettaNotifica(string notifica)
    {
        if(_timernotifica == null)
        {
            _timernotifica = new System.Timers.Timer(5000)
                {
                    AutoReset = false,
                    Enabled = false
                };
            _timernotifica.Elapsed +=  (source, e) =>
            {
                _timernotifica.Enabled = false;
                _notificamsg = null;
                StateHasChanged();
            };
        }
        _notificamsg = notifica;
        _timernotifica.Enabled = true;
    }


    void IDisposable.Dispose() => _reference?.Dispose();

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_JScript is not null)
        {
            await _JScript.DisposeAsync();
        }
    }

}
